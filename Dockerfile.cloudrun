# Multi-stage Dockerfile for Magento 2 on Google Cloud Run
# Stage 1: Build stage - Install dependencies and prepare application
FROM composer:2 AS composer-stage

WORKDIR /app

# Copy composer files
COPY composer.json composer.lock ./

# Install PHP dependencies
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --optimize-autoloader

# Stage 2: Base PHP-FPM image
FROM php:8.2-fpm AS base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    nginx \
    supervisor \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libicu-dev \
    libxml2-dev \
    libxslt-dev \
    libonig-dev \
    libcurl4-openssl-dev \
    git \
    unzip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
    bcmath \
    gd \
    intl \
    mysqli \
    pdo_mysql \
    soap \
    xsl \
    zip \
    opcache \
    sockets \
    pcntl

# Configure PHP-FPM for Cloud Run
RUN sed -i 's/listen = \/run\/php\/php8.2-fpm.sock/listen = 127.0.0.1:9000/' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's/;clear_env = no/clear_env = no/' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's/;pm.status_path = \/status/pm.status_path = \/status/' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's/;ping.path = \/ping/ping.path = \/ping/' /usr/local/etc/php-fpm.d/www.conf

# Configure PHP for Cloud Run
RUN echo "memory_limit = 756M" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "max_execution_time = 18000" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "max_input_time = 18000" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "post_max_size = 64M" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "upload_max_filesize = 64M" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "opcache.interned_strings_buffer=8" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/magento.ini \
    && echo "opcache.save_comments=1" >> /usr/local/etc/php/conf.d/magento.ini

# Stage 3: Application stage
FROM base AS app

WORKDIR /var/www/html

# Copy composer dependencies from composer stage
COPY --from=composer-stage /app/vendor ./vendor

# Copy application files
COPY . .

# Set proper permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html \
    && mkdir -p /var/www/html/var /var/www/html/generated \
    && chown -R www-data:www-data /var/www/html/var /var/www/html/generated \
    && chmod -R 775 /var/www/html/var /var/www/html/generated

# Copy Cloud Run specific configurations
COPY docker/nginx-cloudrun.conf /etc/nginx/sites-available/default
COPY docker/supervisord-cloudrun.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/cloudrun-entrypoint.sh /usr/local/bin/cloudrun-entrypoint.sh

# Enable nginx site and remove default site if it exists
RUN rm -f /etc/nginx/sites-enabled/default \
    && ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default \
    && chmod +x /usr/local/bin/cloudrun-entrypoint.sh

# Expose port 8080 (Cloud Run default)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health_check.php || exit 1

# Use supervisord to manage nginx and PHP-FPM
CMD ["/usr/local/bin/cloudrun-entrypoint.sh"]
