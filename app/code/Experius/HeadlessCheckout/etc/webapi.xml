<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <!-- Headless checkout update - Guest -->
    <route url="/V1/checkout/headless/update" method="POST">
        <service class="Experius\HeadlessCheckout\Api\GuestHeadlessCheckoutManagementInterface" method="updateCheckout"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>

    <!-- Headless checkout update - Customer -->
    <route url="/V1/checkout/headless/update" method="POST">
        <service class="Experius\HeadlessCheckout\Api\HeadlessCheckoutManagementInterface" method="updateCheckout"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>

    <!-- Headless checkout place order - Guest -->
    <route url="/V1/checkout/headless/place-order" method="POST">
        <service class="Experius\HeadlessCheckout\Api\GuestHeadlessCheckoutManagementInterface" method="placeOrder"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>

    <!-- Headless checkout place order - Customer -->
    <route url="/V1/checkout/headless/place-order" method="POST">
        <service class="Experius\HeadlessCheckout\Api\HeadlessCheckoutManagementInterface" method="placeOrder"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>
</routes>
