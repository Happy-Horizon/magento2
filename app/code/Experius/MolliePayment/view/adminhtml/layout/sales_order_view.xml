<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="order_payment">
            <block class="Experius\MolliePayment\Block\Adminhtml\Order\View\Payment\Info" 
                   name="mollie_payment_info" 
                   template="Experius_MolliePayment::order/view/payment/info.phtml" 
                   after="order_payment_method"/>
        </referenceBlock>
        <referenceBlock name="sales_order_tabs">
            <block class="Experius\MolliePayment\Block\Adminhtml\Order\View\Tab\Payment" 
                   name="sales_order_view_tab_mollie_payment" 
                   template="Experius_MolliePayment::order/view/tab/payment.phtml">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Mollie Payment</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
